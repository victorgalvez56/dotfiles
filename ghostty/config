# ================================================
# Ghostty — Claude Code terminal workflow
# ================================================

# Font
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-thicken = true
font-feature = calt
font-feature = liga
adjust-cell-height = 20%

# Window
window-padding-x = 12
window-padding-y = 8
window-decoration = true
macos-titlebar-style = tabs
window-save-state = always

# Background image — place your PNG at ~/Pictures/ghostty-bg.png
# install.sh writes the absolute path for your user at install time
background-image = ~/Pictures/ghostty-bg.png
background-image-fit = cover
background-image-repeat = false
background-image-opacity = 0.15

# Background & transparency
background-opacity = 0.95
background = 0a1220
unfocused-split-opacity = 0.85

# Foreground
foreground = d8dce8

# Normal colors (0-7) — designed for wave background contrast
palette = 0=#1c2b3d
palette = 1=#ff7b7b
palette = 2=#7eeba5
palette = 3=#f0c95c
palette = 4=#7cb8f0
palette = 5=#c9a0f0
palette = 6=#5fe0d0
palette = 7=#bfc8d4

# Bright colors (8-15)
palette = 8=#3d5570
palette = 9=#ffa0a0
palette = 10=#a4f5c2
palette = 11=#ffe09a
palette = 12=#a8d8ff
palette = 13=#dfbfff
palette = 14=#8cf0e2
palette = 15=#e8edf5

# Cursor — gold, visible over any wave area
cursor-color = f0c95c
cursor-text = 0a1220
cursor-style = block
cursor-style-blink = false

# Selection
selection-background = 2a4a6a
selection-foreground = e8edf5

# Splits — for nvim + claude side by side
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:top
keybind = cmd+opt+down=goto_split:bottom

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface

# Quick resize splits
keybind = cmd+opt+shift+left=resize_split:left,20
keybind = cmd+opt+shift+right=resize_split:right,20
keybind = cmd+opt+shift+up=resize_split:up,20
keybind = cmd+opt+shift+down=resize_split:down,20

# Copy/paste
copy-on-select = clipboard
clipboard-paste-protection = false

# Scrollback
scrollback-limit = 50000

# Shell integration
shell-integration = zsh
shell-integration-features = cursor,sudo,title
